# Copy this file to .env for local overrides. Never commit a real .env.

# ---------------------------------------------------------------------------
# Database
# Current local implementation uses SQLite and does not need these values.
# Set data_acquisition/config.yaml database.driver to "postgresql" to use them.
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=churn_ops
POSTGRES_USER=churn_app
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Future external API credentials
# The default API source is a local mock and does not use a token.
# ---------------------------------------------------------------------------
# CHURN_API_BASE_URL=
# CHURN_API_TOKEN=
